# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- MySQL (optional: auto-connects on startup; you can also connect from the UI) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- Safety ---
# readonly = SELECT/SHOW/DESCRIBE only | write = + INSERT/UPDATE/DELETE/CREATE/ALTER | admin = + DROP/TRUNCATE
APP_ROLE=write
MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=15
MAX_CORRECTIONS=2
CORS_ORIGINS=http://localhost:5173
